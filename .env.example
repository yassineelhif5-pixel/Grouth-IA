# ───────────── Growth IA — environment variables (NO real secrets in this file) ─────────────
# Django
DJANGO_SECRET_KEY=                 # long random string (required)
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:8080
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# Database — Supabase PostgreSQL (Project Settings → Database). Prefer the session pooler.
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres                   # production: dedicated LOGIN role `growth_backend` member of app_backend
DB_PASSWORD=
DB_SSLMODE=require
DB_ROLE=app_backend                # runtime role (RLS enforced); empty only for `migrate`

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ANON_KEY=                 # public key (also used by the frontend)
SUPABASE_SERVICE_ROLE_KEY=         # backend only — never expose to the browser
SUPABASE_JWT_SECRET=               # only for legacy HS256 projects (JWKS used otherwise)
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=tenant-files

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Security
SECRETS_ENCRYPTION_KEY=            # Fernet key (fallback encryption; secrets live in Supabase Vault)
PILOT_REQUIRE_MFA=true
THROTTLE_USER=600/min
THROTTLE_ANON=30/min
INVITATION_TTL_HOURS=168
EXPORT_LINK_TTL_SECONDS=900

# E-mail (notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Growth IA <no-reply@example.com>

# PROMPT 2 — intégrations (clés IA, OAuth et connecteurs : saisis dans la console, chiffrés en base)
PUBLIC_API_URL=https://api.example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRAWLER_USER_AGENT=GrowthIA-Bot/1.0 (+https://example.com/bot)
CRAWLER_MAX_PAGES=200
CRAWLER_DELAY_SECONDS=1
ATTACHMENT_MAX_BYTES=15728640

# Frontend build (Vite)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
